RewriteEngine On

# 1. Canonicalize domain: force non-www (your existing rule)
RewriteCond %{HTTP_HOST} ^www\.banshiwale\.com$ [NC]
RewriteRule ^(.*)$ https://banshiwale.com/$1 [L,R=301]

# 2. Redirect visible .html URLs to clean URLs (for browser bar + SEO)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Internally serve the .html file when a clean URL is requested
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# 4. Compress text-based responses (HTML/CSS/JS/JSON/SVG). Images, video,
# and fonts are already compressed formats, so they're left out.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. Browser caching.
#
# Images/fonts/video get a long cache lifetime — they rarely change, and
# when they do they're swapped in under a new filename.
#
# HTML/CSS/JS get a short one instead of the usual "cache forever" advice:
# main.css, tailwind.build.css, and main.js keep the same filename across
# deploys (no content hash/version query string), so a long max-age here
# would serve stale code to returning visitors after every future deploy.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"

  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|mp4|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
